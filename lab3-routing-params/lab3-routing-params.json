              "name": "GET Nonexistent Recipe (404)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Статус 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"Ответ в формате JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Сообщение об ошибке указывает на отсутствие рецепта\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"error\");\r\n    pm.expect(jsonData.error.toLowerCase()).to.include(\"не найден\");\r\n});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "http://localhost:3000/recipes/999",
                  "protocol": "http",
                  "host": [
                    "localhost"
                  ],
                  "port": "3000",
                  "path": [
                    "recipes",
                    "999"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "GET Invalid Recipe ID (400)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Статус 400 Bad Request\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Ответ в формате JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Сообщение об ошибке указывает на неверный формат ID\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"error\");\r\n    pm.expect(jsonData.error.toLowerCase()).to.satisfy(function(text) {\r\n        return text.includes(\"числом\") || text.includes(\"неверн\");\r\n    });\r\n});"
                    ]
                  }
                }
